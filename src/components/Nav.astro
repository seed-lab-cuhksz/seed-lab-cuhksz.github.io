---
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(href + "/");

const splitLabel = (label: string) => {
  const i = label.search(/[A-Za-z]/);
  if (i < 0) return { cn: label, en: "" };
  return {
    cn: label.slice(0, i).trim(),
    en: label.slice(i).trim(),
  };
};
---

<header class="sticky top-0 z-50 border-b border-primary-100/70 bg-white/82 backdrop-blur-xl supports-[backdrop-filter]:bg-white/72">
  <nav class="container-page flex h-[4.5rem] items-center justify-between gap-4" aria-label="主导航 Primary navigation">
    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label="SEED Lab 首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 36 36" class="h-full w-full">
          <path d="M18 25.5c-5.2-3.2-7.9-7.2-7.2-11.5.6-3.8 3.3-6.5 7.2-8 3.9 1.5 6.6 4.2 7.2 8 .7 4.3-2 8.3-7.2 11.5Z" fill="currentColor" opacity=".92" />
          <path d="M18 15.4c1.5-5 5.2-7.7 10.1-7.4-1.1 4.4-4.1 7.3-10.1 8.9Z" fill="#7fd1c5" />
          <path d="M18 15.8v12.4" stroke="#f2f8f4" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </span>
      <span class="leading-none">
        <b class="block text-[1.05rem] font-extrabold tracking-[-.025em] text-seed-ink transition-colors group-hover:text-primary-700">SEED Lab</b>
        <small class="mt-1 block text-[8px] font-semibold tracking-[.12em] text-primary-500 uppercase">Early Development</small>
      </span>
    </a>

    <ul class="hidden items-stretch gap-0.5 xl:flex">
      {site.nav.map((item) => {
        const label = splitLabel(item.label);
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "nav-link group relative flex min-w-[4.6rem] flex-col items-center justify-center rounded-xl px-2.5 py-2 transition-all",
                active ? "bg-primary-50 text-primary-800" : "text-slate-600 hover:bg-primary-50/65 hover:text-primary-800",
              ]}
            >
              <span class="text-[11px] font-semibold leading-none">{label.cn}</span>
              <span class:list={["mt-1 text-[7px] font-bold tracking-[.08em] uppercase", active ? "text-accent-600" : "text-slate-400 group-hover:text-primary-500"]}>{label.en}</span>
              {active && <i class="absolute -bottom-[1px] left-1/2 h-[2px] w-5 -translate-x-1/2 rounded-full bg-accent-500"></i>}
            </a>
          </li>
        );
      })}
    </ul>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-primary-100 bg-white text-primary-800 transition hover:border-primary-300 hover:bg-primary-50 xl:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">打开导航菜单</span>
      <svg class="nav-icon-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="nav-icon-close h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-primary-100 bg-white/96 backdrop-blur-xl xl:hidden">
    <ul class="container-page grid gap-2 py-4 sm:grid-cols-2">
      {site.nav.map((item) => {
        const label = splitLabel(item.label);
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center justify-between rounded-xl border px-4 py-3 transition",
                active ? "border-primary-200 bg-primary-50 text-primary-800" : "border-transparent text-slate-700 hover:border-primary-100 hover:bg-primary-50/60",
              ]}
            >
              <span class="font-semibold">{label.cn}</span>
              <span class="font-mono text-[9px] tracking-[.08em] text-primary-500 uppercase">{label.en}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("hidden");
  });
</script>

<style>
  .brand-mark {
    display: inline-flex;
    height: 2.35rem;
    width: 2.35rem;
    align-items: center;
    justify-content: center;
    border-radius: .85rem;
    background: #17312a;
    color: #f2f8f4;
    box-shadow: 0 8px 20px rgba(23,49,42,.12);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  a:hover .brand-mark {
    transform: rotate(-3deg) translateY(-1px);
    box-shadow: 0 12px 24px rgba(23,49,42,.16);
  }
  #nav-toggle .nav-icon-close { display: none; }
  #nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
  #nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }
</style>
