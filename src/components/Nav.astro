---
import { site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(href + "/");

const splitLabel = (label: string) => {
  const i = label.search(/[A-Za-z]/);
  if (i < 0) return { cn: label, en: "" };
  return {
    cn: label.slice(0, i).trim(),
    en: label.slice(i).trim(),
  };
};
---

<header class="sticky top-0 z-50 border-b border-[#e8e3d9] bg-[#fffdf9]/95 backdrop-blur-md">
  <nav class="container-page flex h-[4.5rem] items-center justify-between gap-5" aria-label="主导航 Primary navigation">
    <a href="/" class="group flex shrink-0 items-baseline gap-2" aria-label="SEED Lab 首页">
      <span class="text-[1.22rem] font-bold tracking-[-.035em] text-[#202c29] transition-colors group-hover:text-[#6f9244]">SEED</span>
      <span class="text-[.82rem] font-medium tracking-[.04em] text-[#efb487]">Lab</span>
    </a>

    <ul class="hidden h-full items-center gap-6 xl:flex">
      {site.nav.map((item) => {
        const label = splitLabel(item.label);
        const active = isActive(item.href);
        return (
          <li class="h-full">
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "group relative flex h-full flex-col items-center justify-center px-0.5 transition-colors",
                active ? "text-[#202c29]" : "text-[#66706d] hover:text-[#202c29]",
              ]}
            >
              <span class="text-[11px] font-semibold leading-none">{label.cn}</span>
              <span class="mt-1.5 text-[7px] font-medium tracking-[.12em] text-[#a3a6a1] uppercase">{label.en}</span>
              <span class:list={["absolute bottom-0 left-1/2 h-[2px] -translate-x-1/2 bg-[#6f9244] transition-all", active ? "w-6" : "w-0 group-hover:w-4"]}></span>
            </a>
          </li>
        );
      })}
    </ul>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[#202c29] transition hover:bg-[#f6f1e8] xl:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">打开导航菜单</span>
      <svg class="nav-icon-open h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="nav-icon-close h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-[#e8e3d9] bg-[#fffdf9] xl:hidden">
    <ul class="container-page grid gap-x-8 py-5 sm:grid-cols-2">
      {site.nav.map((item) => {
        const label = splitLabel(item.label);
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-baseline justify-between border-b border-[#eee9df] py-3.5 transition-colors",
                active ? "text-[#6f9244]" : "text-[#303a37] hover:text-[#6f9244]",
              ]}
            >
              <span class="text-sm font-semibold">{label.cn}</span>
              <span class="text-[8px] tracking-[.12em] text-[#aaa69f] uppercase">{label.en}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("hidden");
  });
</script>

<style>
  #nav-toggle .nav-icon-close { display: none; }
  #nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
  #nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }
</style>
