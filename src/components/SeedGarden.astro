<script>
  const garden = document.querySelector<HTMLElement>("[data-seed-garden]");
  if (garden) {
    const movers = garden.querySelectorAll<HTMLElement>(".garden-sway, .garden-star");

    const setWind = (value: number) => {
      movers.forEach((item) => {
        const factor = Number(item.dataset.factor || 1);
        item.style.setProperty("--pointer-angle", `${value * factor * 5}deg`);
      });
    };

    garden.addEventListener("pointermove", (event) => {
      const rect = garden.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      setWind(x);
    });

    garden.addEventListener("pointerleave", () => setWind(0));
  }
</script>

<style>
  .seed-garden {
    width: min(100%, 43rem);
    margin-top: .8rem;
    touch-action: none;
  }

  .seed-garden__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .garden-sway,
  .garden-star {
    --pointer-angle: 0deg;
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: garden-breeze 4.8s ease-in-out infinite;
    transition: filter .25s ease;
  }

  .garden-sway:nth-of-type(2n),
  .garden-star:nth-of-type(2n) {
    animation-duration: 5.7s;
    animation-delay: -.9s;
  }

  .garden-sway:nth-of-type(3n) {
    animation-duration: 4.2s;
    animation-delay: -1.5s;
  }

  .seed-garden:hover .garden-sway,
  .seed-garden:hover .garden-star {
    filter: saturate(1.05);
  }

  .garden-dot {
    animation: garden-twinkle 3.8s ease-in-out infinite;
  }

  @keyframes garden-breeze {
    0%, 100% { transform: rotate(calc(var(--pointer-angle) - 1deg)) translateY(0); }
    50% { transform: rotate(calc(var(--pointer-angle) + 1.8deg)) translateY(-1px); }
  }

  @keyframes garden-twinkle {
    0%, 100% { opacity: .45; transform: scale(.92); }
    50% { opacity: 1; transform: scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-sway,
    .garden-star,
    .garden-dot {
      animation: none;
    }
  }
</style>
