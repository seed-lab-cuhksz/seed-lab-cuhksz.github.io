---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="bg-gradient-to-b from-primary-50 to-white">
  <div class="container-page py-10 sm:py-14">
    {
      eyebrow && (
        <p class="text-xs font-semibold tracking-wide text-accent-600 uppercase">
          {eyebrow}
        </p>
      )
    }
    <div
      class:list={["h-0.5 w-10 rounded-full bg-accent-500", eyebrow ? "mt-3" : ""]}
    />
    <h1 class="mt-3 text-3xl font-semibold leading-tight text-slate-900 sm:text-4xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-[1.02rem]">{lead}</p>}
  </div>
</header>
