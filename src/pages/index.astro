---
import BaseLayout from "../components/BaseLayout.astro";
import SeedLogo from "../components/SeedLogo.astro";
import SeedGarden from "../components/SeedGarden.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="首页 Home"
  description={site.description}
  hideFooter={true}
>
  <section class="home-stage relative isolate overflow-hidden bg-[#faf7ef]">
    <div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(255,255,255,.30),rgba(255,255,255,0)_38%)]"></div>
    <div class="soft-orb soft-orb-a" aria-hidden="true"></div>
    <div class="soft-orb soft-orb-b" aria-hidden="true"></div>

    <div class="container-page grid min-h-[calc(100svh-4.5rem)] items-center gap-10 py-8 lg:grid-cols-[.9fr_1.1fr] lg:gap-20 lg:py-7">
      <div class="brand-side relative flex min-h-[27rem] flex-col justify-center lg:min-h-0">
        <div class="relative z-10 w-full max-w-[34rem]">
          <SeedLogo />
          <p class="mt-5 text-[10px] font-medium tracking-[.2em] text-[#7d817d] uppercase">
            The Chinese University of Hong Kong, Shenzhen
          </p>
        </div>

        <div class="garden-wrap relative z-0 -mt-1 w-full max-w-[39rem]">
          <SeedGarden />
        </div>
      </div>

      <div class="copy-side relative max-w-[47rem] lg:justify-self-end">
        <p class="mb-6 text-[11px] font-semibold tracking-[.14em] text-[#769348]">
          香港中文大学（深圳） · 儿童发展研究
        </p>

        <h1 class="text-[clamp(2.5rem,5.1vw,5rem)] font-semibold leading-[1.04] tracking-[-.055em] text-[#202c29]">
          理解儿童如何
          <span class="block text-[#769348]">看见、互动与成长</span>
        </h1>

        <p class="mt-5 font-serif text-[clamp(1.1rem,1.5vw,1.35rem)] italic leading-relaxed text-[#9a7460]">
          Understanding how children see, connect, and grow.
        </p>

        <p class="mt-8 max-w-[42rem] text-[15px] leading-8 text-[#626a66] sm:text-base">
          我们关注 0–3 岁婴幼儿的认知、情感与社会发展，并通过行为观察、眼动、脑成像与计算方法，理解早期发展中的共同规律与个体差异。
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm font-semibold">
          <a href="/research" class="home-link group">
            了解我们的研究
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/contact#families" class="home-link group">
            家庭参与
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-stage {
    min-height: calc(100svh - 4.5rem);
  }

  .soft-orb {
    position: absolute;
    z-index: -10;
    border-radius: 999px;
    filter: blur(65px);
    pointer-events: none;
  }

  .soft-orb-a {
    left: -8rem;
    bottom: -7rem;
    width: 28rem;
    height: 23rem;
    background: rgba(201, 216, 174, .24);
  }

  .soft-orb-b {
    left: 28%;
    bottom: -11rem;
    width: 22rem;
    height: 17rem;
    background: rgba(239, 190, 151, .10);
  }

  .brand-side {
    transform-origin: 40% 55%;
  }

  .garden-wrap {
    transition: transform .35s cubic-bezier(.2,.7,.2,1);
  }

  .brand-side:hover .garden-wrap {
    transform: translateY(-2px);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border-bottom: 1px solid #b9b4a9;
    padding-bottom: .3rem;
    color: #293531;
    transition: border-color .2s ease, color .2s ease;
  }

  .home-link span {
    color: #77964b;
    transition: transform .22s ease;
  }

  .home-link:hover {
    border-color: #77964b;
    color: #77964b;
  }

  .home-link:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 1023px) {
    .brand-side {
      align-items: center;
      min-height: 24rem;
    }

    .brand-side > div,
    .garden-wrap {
      margin-left: auto;
      margin-right: auto;
    }

    .brand-side p {
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .home-stage {
      min-height: auto;
    }

    .brand-side {
      min-height: 19rem;
    }

    .garden-wrap {
      margin-top: -.5rem;
    }
  }
</style>
