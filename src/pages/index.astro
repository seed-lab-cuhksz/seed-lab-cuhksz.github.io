---
import BaseLayout from "../components/BaseLayout.astro";
import SeedLogo from "../components/SeedLogo.astro";
import SeedGarden from "../components/SeedGarden.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="首页 Home"
  description={site.description}
  hideFooter={true}
>
  <section class="home-stage relative isolate overflow-hidden bg-[#faf7ef]">
    <div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(255,255,255,.30),rgba(255,255,255,0)_38%)]"></div>
    <div class="soft-orb soft-orb-a" aria-hidden="true"></div>
    <div class="soft-orb soft-orb-b" aria-hidden="true"></div>

    <div class="container-page grid min-h-[calc(100svh-5.35rem)] items-center gap-10 py-7 lg:grid-cols-[.9fr_1.1fr] lg:gap-20 lg:py-6">
      <div class="brand-side relative flex min-h-[27rem] flex-col justify-center lg:min-h-0">
        <div class="relative z-10 w-full max-w-[34rem]">
          <SeedLogo />
          <p class="mt-5 text-[10px] font-medium tracking-[.2em] text-[#7d817d] uppercase">
            The Chinese University of Hong Kong, Shenzhen
          </p>
        </div>

        <div class="garden-wrap relative z-0 -mt-1 w-full max-w-[39rem]">
          <SeedGarden />
        </div>
      </div>

      <div class="copy-side relative max-w-[47rem] lg:justify-self-end">
        <p class="mb-4 text-[11px] font-semibold tracking-[.14em] text-[#769348]">
          香港中文大学（深圳） · 儿童发展研究
        </p>

        <h1 class="text-[clamp(2.35rem,4.65vw,4.65rem)] font-semibold leading-[1.03] tracking-[-.055em] text-[#202c29]">
          理解儿童如何
          <span class="block text-[#769348]">看见、互动与成长</span>
        </h1>

        <p class="mt-4 font-serif text-[clamp(1.05rem,1.4vw,1.25rem)] italic leading-relaxed text-[#9a7460]">
          Understanding how children see, connect, and grow.
        </p>

        <div class="parent-intro mt-6 max-w-[44rem]">
          <p class="parent-intro__greeting">欢迎来到 SEED Lab</p>
          <p>
            我们是香港中文大学（深圳）SEED儿童早期社会发展实验室。我们致力于研究0-3岁婴幼儿的认知、情感和社交发展，以及自闭症等发育障碍的预防和评估。
          </p>
          <p>
            实验室由曾广宇教授和他的博士、硕士研究生负责。其中，曾教授拥有美国迈阿密大学博士学位，主攻儿童发展和计量心理学，并有多年国内外特殊儿童言语和行为治疗的经验。目前，曾教授担任香港中文大学（深圳）应用心理学助理教授。我们的研究主要探索儿童早期的个体特征与健康发展之间的关系，多项研究成果已发表在国际顶级学术期刊，如《Behavior Research Methods》《Child Development》《Autism Research》《Infancy》等。
          </p>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm font-semibold">
          <a href="/publications#research-directions" class="home-link group">
            了解我们的研究
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/contact#families" class="home-link group">
            家庭参与
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-stage { min-height: calc(100svh - 5.35rem); }
  .soft-orb { position: absolute; z-index: -10; border-radius: 999px; filter: blur(65px); pointer-events: none; }
  .soft-orb-a { left: -8rem; bottom: -7rem; width: 28rem; height: 23rem; background: rgba(201, 216, 174, .24); }
  .soft-orb-b { left: 28%; bottom: -11rem; width: 22rem; height: 17rem; background: rgba(239, 190, 151, .10); }
  .brand-side { transform-origin: 40% 55%; }
  .garden-wrap { transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .brand-side:hover .garden-wrap { transform: translateY(-2px); }
  .parent-intro { border-left: 2px solid rgba(119, 150, 75, .32); padding-left: 1rem; color: #626a66; font-size: 13.5px; line-height: 1.82; }
  .parent-intro p + p { margin-top: .65rem; }
  .parent-intro__greeting { font-weight: 700; color: #39463f; }
  .home-link { display: inline-flex; align-items: center; gap: .45rem; border-bottom: 1px solid #b9b4a9; padding-bottom: .3rem; color: #293531; transition: border-color .2s ease, color .2s ease; }
  .home-link span { color: #77964b; transition: transform .22s ease; }
  .home-link:hover { border-color: #77964b; color: #77964b; }
  .home-link:hover span { transform: translate(2px, -2px); }
  @media (max-width: 1180px) and (min-width: 1024px) { .parent-intro { font-size: 12.8px; line-height: 1.72; } }
  @media (max-width: 1023px) {
    .home-stage { overflow: visible; }
    .brand-side { align-items: center; min-height: 24rem; }
    .brand-side > div, .garden-wrap { margin-left: auto; margin-right: auto; }
    .brand-side p { text-align: center; }
    .copy-side { max-width: 46rem; margin: 0 auto; }
  }
  @media (max-width: 640px) {
    .home-stage { min-height: auto; }
    .brand-side { min-height: 19rem; }
    .garden-wrap { margin-top: -.5rem; }
    .parent-intro { font-size: 13px; line-height: 1.8; }
  }
</style>
