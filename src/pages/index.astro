---
import BaseLayout from "../components/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="首页 Home"
  description={site.description}
  hideFooter={true}
>
  <section class="home-stage relative isolate overflow-hidden bg-[#faf7ef]">
    <div class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(255,255,255,.28),rgba(255,255,255,0)_36%)]"></div>

    <svg class="growth-line pointer-events-none absolute -left-16 bottom-[-8%] -z-10 h-[112%] w-[58%] min-w-[520px] opacity-70" viewBox="0 0 760 820" fill="none" aria-hidden="true">
      <path class="growth-path" d="M132 806C165 696 198 598 239 511C278 426 330 363 389 302C448 242 492 174 509 99" stroke="#77964b" stroke-width="3.2" stroke-linecap="round" />
      <path d="M394 295C333 255 286 253 246 278C282 316 329 326 394 295Z" fill="#77964b" opacity=".92" />
      <path d="M491 155C539 119 588 111 626 127C600 174 557 194 491 155Z" fill="#77964b" opacity=".92" />
      <circle class="peach-dot" cx="509" cy="99" r="11" fill="#efb487" />
    </svg>

    <div class="container-page grid min-h-[calc(100svh-4.5rem)] items-center gap-12 py-10 lg:grid-cols-[.86fr_1.14fr] lg:gap-20 lg:py-8">
      <div class="brand-side relative flex min-h-[24rem] items-center justify-center lg:min-h-0 lg:justify-start">
        <div class="relative w-full max-w-[26rem]">
          <img
            src="/seed-lab-logo.webp"
            alt="SEED Social Excellence for Early Development Lab"
            class="official-logo mx-auto block w-full max-w-[23rem] lg:mx-0"
            width="190"
            height="140"
          />
          <p class="mt-8 text-center text-[10px] font-medium tracking-[.2em] text-[#7d817d] uppercase lg:text-left">
            The Chinese University of Hong Kong, Shenzhen
          </p>
        </div>
      </div>

      <div class="copy-side relative max-w-[47rem] lg:justify-self-end">
        <p class="mb-6 text-[11px] font-semibold tracking-[.14em] text-[#769348]">
          香港中文大学（深圳） · 儿童发展研究
        </p>

        <h1 class="text-[clamp(2.5rem,5.1vw,5rem)] font-semibold leading-[1.04] tracking-[-.055em] text-[#202c29]">
          理解儿童如何
          <span class="block text-[#769348]">看见、互动与成长</span>
        </h1>

        <p class="mt-5 font-serif text-[clamp(1.1rem,1.5vw,1.35rem)] italic leading-relaxed text-[#9a7460]">
          Understanding how children see, connect, and grow.
        </p>

        <p class="mt-8 max-w-[42rem] text-[15px] leading-8 text-[#626a66] sm:text-base">
          我们关注 0–3 岁婴幼儿的认知、情感与社会发展，并通过行为观察、眼动、脑成像与计算方法，理解早期发展中的共同规律与个体差异。
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 text-sm font-semibold">
          <a href="/research" class="home-link group">
            了解我们的研究
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/contact#families" class="home-link group">
            家庭参与
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-stage {
    min-height: calc(100svh - 4.5rem);
  }

  .official-logo {
    filter: saturate(.96) contrast(1.01);
    transform-origin: 42% 64%;
    transition: transform .55s cubic-bezier(.2,.7,.2,1);
  }

  .brand-side:hover .official-logo {
    transform: translateY(-3px) rotate(-.35deg);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border-bottom: 1px solid #b9b4a9;
    padding-bottom: .3rem;
    color: #293531;
    transition: border-color .2s ease, color .2s ease;
  }

  .home-link span {
    color: #77964b;
    transition: transform .22s ease;
  }

  .home-link:hover {
    border-color: #77964b;
    color: #77964b;
  }

  .home-link:hover span {
    transform: translate(2px, -2px);
  }

  .growth-path {
    stroke-dasharray: 950;
    stroke-dashoffset: 950;
    animation: grow-line 1.45s .12s cubic-bezier(.2,.7,.2,1) forwards;
  }

  .peach-dot {
    transform-origin: 509px 99px;
    animation: dot-breathe 4.5s 1.5s ease-in-out infinite;
  }

  @keyframes grow-line {
    to { stroke-dashoffset: 0; }
  }

  @keyframes dot-breathe {
    0%, 100% { transform: scale(1); opacity: .82; }
    50% { transform: scale(1.16); opacity: 1; }
  }

  @media (max-width: 1023px) {
    .growth-line {
      left: -12rem;
      width: 80%;
      opacity: .42;
    }
  }

  @media (max-width: 640px) {
    .home-stage {
      min-height: auto;
    }

    .growth-line {
      left: -16rem;
      bottom: 8%;
      width: 120%;
      opacity: .28;
    }

    .brand-side {
      min-height: 17rem;
    }

    .official-logo {
      max-width: 17rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .growth-path {
      stroke-dashoffset: 0;
      animation: none;
    }

    .peach-dot {
      animation: none;
    }
  }
</style>
