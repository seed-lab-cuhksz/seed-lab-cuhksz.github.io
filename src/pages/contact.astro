---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;

const contactPaths = [
  {
    id: "collaborate",
    number: "01",
    title: "合作交流 Collaborate with Us",
    body: "我们欢迎与儿童发展、家庭研究、心理与教育技术、行为测量及相关交叉领域的研究团队开展合作。",
    note: "如有合作想法，可通过实验室邮箱联系我们。",
  },
  {
    id: "join",
    number: "02",
    title: "加入我们 Join the Team",
    body: "我们欢迎对儿童早期发展研究感兴趣的本科生、研究助理及其他研究伙伴关注实验室机会。",
    note: "点击查看申请方式与材料要求。",
  },
  {
    id: "families",
    number: "03",
    title: "家庭参与 For Families",
    body: "我们长期邀请婴幼儿与家庭参与儿童发展研究及“小小科学家 Kid Scientists”计划，在轻松、安全的活动中一起探索儿童成长。",
    note: "后续将在这里集中展示适龄活动、参与方式与家庭常见问题。",
  },
];
---

<BaseLayout
  title="联系我们 Contact"
  description="与SEED儿童早期社会发展实验室合作、加入团队或参与家庭研究。"
>
  <PageHeader
    eyebrow="联系 SEED"
    title="联系我们 Contact"
    lead="无论你希望开展研究合作、加入团队，还是带孩子参与我们的研究，都可以从这里找到对应入口。"
  />

  <div class="container-page py-12">
    <div class="grid gap-5 lg:grid-cols-3">
      {contactPaths.map((item) => (
        <section
          id={item.id}
          class:list={[
            "group relative scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-lg",
            item.id === "join" && "cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2",
          ]}
          data-join-trigger={item.id === "join" ? "true" : undefined}
          role={item.id === "join" ? "button" : undefined}
          tabindex={item.id === "join" ? "0" : undefined}
          aria-haspopup={item.id === "join" ? "dialog" : undefined}
        >
          <div class="absolute -right-2 -top-5 font-mono text-7xl font-semibold text-primary-50 transition-colors group-hover:text-primary-100">
            {item.number}
          </div>
          <h2 class="relative max-w-[16rem] font-serif text-2xl font-semibold leading-tight text-slate-900 group-hover:text-primary-700">
            {item.title}
          </h2>
          <p class="relative mt-5 leading-7 text-slate-600">{item.body}</p>
          <p class="relative mt-6 border-t border-slate-100 pt-4 text-sm leading-6 text-slate-500">{item.note}</p>
        </section>
      ))}
    </div>

    <section class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
      <div class="grid lg:grid-cols-[0.85fr_1.15fr]">
        <div class="p-7 sm:p-9">
          <p class="text-xs font-semibold tracking-[0.16em] text-accent-600">来访信息</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-slate-900">实验室位置 Location</h2>
          <p class="mt-4 leading-7 text-slate-600">SEED 儿童早期社会发展实验室位于香港中文大学（深圳）。具体楼宇与来访指引将在正式上线前补充。</p>
          <a
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 transition-colors hover:text-accent-600"
          >
            在地图中查看
            <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="min-h-72 overflow-hidden border-t border-slate-200 lg:border-l lg:border-t-0">
          <iframe
            title="香港中文大学（深圳）地图"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-full min-h-72 w-full"
          ></iframe>
        </div>
      </div>
    </section>
  </div>

  <div
    id="join-team-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[2px] sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-label="加入我们申请说明"
    aria-hidden="true"
  >
    <div class="relative max-h-[92vh] w-full max-w-[720px] overflow-auto rounded-2xl bg-white p-2 shadow-2xl sm:p-3">
      <button
        id="join-team-close"
        type="button"
        aria-label="关闭加入我们弹窗"
        class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-2xl font-light leading-none text-slate-600 shadow-sm transition hover:bg-slate-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"
      >
        <span aria-hidden="true">×</span>
      </button>

      <img
        src="/contact/join-team-poster.png"
        alt="SEED儿童早期社会发展实验室加入我们申请说明"
        width="900"
        height="1125"
        class="h-auto w-full rounded-xl"
      />
    </div>
  </div>

  <script is:inline>
    (() => {
      const modal = document.getElementById("join-team-modal");
      const closeButton = document.getElementById("join-team-close");
      const triggers = document.querySelectorAll('[data-join-trigger="true"]');
      let lastFocused = null;

      if (!modal || !closeButton || triggers.length === 0) return;

      const openModal = () => {
        lastFocused = document.activeElement;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        closeButton.focus();
      };

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        if (lastFocused instanceof HTMLElement) lastFocused.focus();
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener("click", openModal);
        trigger.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openModal();
          }
        });
      });

      closeButton.addEventListener("click", closeModal);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && modal.getAttribute("aria-hidden") === "false") {
          closeModal();
        }
      });
    })();
  </script>
</BaseLayout>
