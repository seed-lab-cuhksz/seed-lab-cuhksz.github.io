---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;

const contactPaths = [
  {
    id: "collaborate",
    number: "01",
    audience: "FOR COLLABORATORS",
    title: "合作交流 Collaborate with Us",
    body: "面向研究者、实验室与相关机构。我们欢迎围绕儿童发展、家庭研究、心理与教育技术、行为测量及相关交叉领域开展合作。",
    note: "点击查看合作联系方式。",
    modal: "collaborate-modal",
  },
  {
    id: "join",
    number: "02",
    audience: "FOR STUDENTS",
    title: "加入我们 Join the Team",
    body: "面向希望参与儿童早期发展研究的本科生、研究生及研究助理申请者，欢迎关注实验室研究与项目机会。",
    note: "点击填写 SEED Lab 新成员申请表。",
    modal: "join-modal",
  },
  {
    id: "families",
    number: "03",
    audience: "FOR FAMILIES",
    title: "家庭参与 For Families",
    body: "面向婴幼儿与家庭。我们长期开展儿童发展研究及“小小科学家 Kid Scientists”计划，在轻松、安全的活动中一起探索儿童成长。",
    note: "点击查看目前可参与的家庭研究。",
    modal: "families-modal",
  },
];
---

<BaseLayout
  title="联系我们 Contact"
  description="与SEED儿童早期社会发展实验室合作、加入团队或参与家庭研究。"
>
  <PageHeader
    eyebrow="联系 SEED"
    title="联系我们 Contact"
    lead="无论你希望开展研究合作、加入团队，还是带孩子参与我们的研究，都可以从这里找到对应入口。"
  />

  <div class="container-page py-12">
    <div class="grid gap-5 lg:grid-cols-3">
      {contactPaths.map((item) => (
        <section
          id={item.id}
          class="group relative scroll-mt-24 cursor-pointer overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2"
          data-modal-target={item.modal}
          role="button"
          tabindex="0"
          aria-haspopup="dialog"
        >
          <div class="absolute -right-2 -top-5 font-mono text-7xl font-semibold text-primary-50 transition-colors group-hover:text-primary-100">{item.number}</div>
          <p class="relative text-[0.68rem] font-semibold tracking-[0.14em] text-accent-600">{item.audience}</p>
          <h2 class="relative mt-3 max-w-[17rem] font-serif text-2xl font-semibold leading-tight text-slate-900 group-hover:text-primary-700">{item.title}</h2>
          <p class="relative mt-5 leading-7 text-slate-600">{item.body}</p>
          <p class="relative mt-6 border-t border-slate-100 pt-4 text-sm leading-6 text-slate-500">{item.note}</p>
        </section>
      ))}
    </div>

    <section class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
        <div class="p-7 sm:p-9">
          <p class="text-xs font-semibold tracking-[0.16em] text-accent-600">来访信息</p>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-slate-900">实验室位置 Location</h2>
          <p class="mt-4 leading-7 text-slate-600">SEED 儿童早期社会发展实验室位于香港中文大学（深圳）。</p>
          <div class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
            <p><strong class="text-slate-800">地址：</strong>广东省深圳市龙岗区龙翔大道 2001 号，香港中文大学（深圳）。</p>
            <p><strong class="text-slate-800">地铁：</strong>可乘 16 号线至大运中心站，D 口出站后步行约 800 米到达校园；也可乘 14 号线至大运站，再换乘 16 号线至大运中心站。</p>
            <p><strong class="text-slate-800">打车 / 自驾：</strong>建议直接导航“香港中文大学（深圳）”。</p>
          </div>
          <a href={mapLink} target="_blank" rel="noopener noreferrer" class="group mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary-700 transition-colors hover:text-accent-600">在地图中查看 <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="min-h-80 overflow-hidden border-t border-slate-200 lg:border-l lg:border-t-0">
          <iframe title="香港中文大学（深圳）地图" src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-full min-h-80 w-full"></iframe>
        </div>
      </div>
    </section>
  </div>

  <div id="collaborate-modal" class="contact-modal fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[2px] sm:p-6" role="dialog" aria-modal="true" aria-label="合作交流" aria-hidden="true">
    <div class="relative w-full max-w-[560px] rounded-2xl bg-white p-7 shadow-2xl sm:p-9">
      <button type="button" data-modal-close aria-label="关闭合作交流弹窗" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-2xl font-light leading-none text-slate-600 transition hover:bg-slate-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"><span aria-hidden="true">×</span></button>
      <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-accent-600">FOR COLLABORATORS</p>
      <h2 class="mt-3 pr-12 font-serif text-2xl font-semibold text-slate-900">合作交流 <span class="text-lg font-normal italic text-slate-500">Collaborate with Us</span></h2>
      <p class="mt-6 leading-7 text-slate-600">如果您有研究、机构或其他合作想法，欢迎添加 SEED Lab 微信：</p>
      <p class="mt-4 text-xl font-semibold tracking-wide text-primary-800">seedlab-cuhksz</p>
      <p class="mt-4 text-sm leading-6 text-slate-500">添加时请简单注明所在机构 / 身份及合作来意，方便我们了解您的需求并进一步联系。</p>
    </div>
  </div>

  <div id="join-modal" class="contact-modal fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[2px] sm:p-6" role="dialog" aria-modal="true" aria-label="加入我们" aria-hidden="true">
    <div class="relative w-full max-w-[650px] rounded-2xl bg-white p-7 shadow-2xl sm:p-9">
      <button type="button" data-modal-close aria-label="关闭加入我们弹窗" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-2xl font-light leading-none text-slate-600 transition hover:bg-slate-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"><span aria-hidden="true">×</span></button>
      <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-accent-600">FOR STUDENTS</p>
      <h2 class="mt-3 pr-12 font-serif text-2xl font-semibold text-slate-900">加入我们 <span class="text-lg font-normal italic text-slate-500">Join the Team</span></h2>
      <p class="mt-6 leading-7 text-slate-600">感谢你对 SEED Lab 的兴趣。如果你希望参与实验室的研究项目或其他研究工作，请填写下方的 <strong class="font-semibold text-slate-800">SEED Lab 新成员申请表</strong>：</p>
      <p class="mt-5 break-words rounded-xl border border-primary-100 bg-primary-50/45 p-4 text-sm leading-7 text-slate-700">
        <a href="https://www.credamo.com/s/fqIRbu/" target="_blank" rel="noreferrer" class="font-semibold text-primary-700 underline decoration-primary-300 underline-offset-4">https://www.credamo.com/s/fqIRbu/</a> cdmyJ8haGSqa 邀请您作答问卷《SEED Lab 新成员申请表》，点击链接开始作答
      </p>
    </div>
  </div>

  <div id="families-modal" class="contact-modal fixed inset-0 z-[100] hidden items-center justify-center bg-slate-950/55 p-4 backdrop-blur-[2px] sm:p-6" role="dialog" aria-modal="true" aria-label="家庭参与" aria-hidden="true">
    <div class="relative max-h-[90vh] w-full max-w-[720px] overflow-auto rounded-2xl bg-white p-7 shadow-2xl sm:p-9">
      <button type="button" data-modal-close aria-label="关闭家庭参与弹窗" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-2xl font-light leading-none text-slate-600 transition hover:bg-slate-50 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400"><span aria-hidden="true">×</span></button>
      <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-accent-600">FOR FAMILIES</p>
      <h2 class="mt-3 pr-12 font-serif text-2xl font-semibold text-slate-900">家庭参与 <span class="text-lg font-normal italic text-slate-500">For Families</span></h2>
      <p class="mt-5 leading-7 text-slate-600">目前有 3 个项目可联系参与：</p>

      <div class="mt-5 space-y-4">
        <article class="rounded-xl border border-slate-200 p-4 sm:p-5">
          <p class="text-xs font-semibold tracking-[0.1em] text-accent-600">5–15 月龄宝宝</p>
          <h3 class="mt-2 font-semibold text-slate-900">线下亲子互动研究</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">宝宝与爸爸或妈妈参加线下亲子互动活动，约每 3 个月参加一次，每次约 1 小时。每次参与补贴约 100–200 元。</p>
        </article>

        <article class="rounded-xl border border-slate-200 p-4 sm:p-5">
          <p class="text-xs font-semibold tracking-[0.1em] text-accent-600">2–5 岁儿童</p>
          <h3 class="mt-2 font-semibold text-slate-900">自然童行 Growing with Nature</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">连续 12 周完成线上问卷，全部完成后参加 1 次户外科研活动。完成全程后补贴 150 元。</p>
        </article>

        <article class="rounded-xl border border-slate-200 p-4 sm:p-5">
          <p class="text-xs font-semibold tracking-[0.1em] text-accent-600">游戏试玩</p>
          <h3 class="mt-2 font-semibold text-slate-900">《十月之礼》游戏小样试玩</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">体验 SEED Lab 开发的孕期教育严肃游戏《十月之礼》小样，免费参与。</p>
        </article>
      </div>

      <div class="mt-6 border-t border-slate-100 pt-5">
        <p class="text-sm leading-6 text-slate-600">感兴趣的家庭欢迎添加 SEED Lab 微信：</p>
        <p class="mt-2 text-xl font-semibold tracking-wide text-primary-800">seedlab-cuhksz</p>
        <p class="mt-2 text-sm leading-6 text-slate-500">添加时可以简单说明宝宝年龄 / 想参加的项目。</p>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const triggers = document.querySelectorAll('[data-modal-target]');
      const modals = document.querySelectorAll('.contact-modal');
      let lastFocused = null;

      const closeModal = (modal) => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (lastFocused instanceof HTMLElement) lastFocused.focus();
      };

      const openModal = (modal) => {
        lastFocused = document.activeElement;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelector('[data-modal-close]')?.focus();
      };

      triggers.forEach((trigger) => {
        const activate = () => {
          const id = trigger.getAttribute('data-modal-target');
          const modal = id ? document.getElementById(id) : null;
          if (modal) openModal(modal);
        };
        trigger.addEventListener('click', activate);
        trigger.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            activate();
          }
        });
      });

      modals.forEach((modal) => {
        modal.querySelector('[data-modal-close]')?.addEventListener('click', () => closeModal(modal));
        modal.addEventListener('click', (event) => {
          if (event.target === modal) closeModal(modal);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const activeModal = Array.from(modals).find((modal) => modal.getAttribute('aria-hidden') === 'false');
        if (activeModal) closeModal(activeModal);
      });
    })();
  </script>
</BaseLayout>
