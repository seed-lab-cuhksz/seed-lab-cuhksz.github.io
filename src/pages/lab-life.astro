---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const photos = [
  "/lab-gallery/7e827fe8f779facc9816bbaa1d88e100.jpg",
  "/lab-gallery/b0451d00f9aae79d4d96cb2d4d85d363.jpg",
  "/lab-gallery/d50300555d964b024c47afdd5339421a.jpg",
  "/lab-gallery/e25934463f17e18d4d48cde70981c52f.jpg",
  "/lab-gallery/fa785d4e14b37173a56e592d9af3aadd.jpg",
];
---

<BaseLayout
  title="实验室日常 Lab Life"
  description="SEED Lab 的实验室日常照片。"
>
  <PageHeader
    eyebrow="SEED LAB · LAB LIFE"
    title="实验室日常 Lab Life"
    lead="记录研究、活动与实验室里的日常片段。"
  />

  <main class="container-page py-10 sm:py-12">
    <section class="photo-wall" data-photo-wall aria-label="SEED Lab 实验室日常照片">
      {photos.map((photo, index) => (
        <figure class="photo-card" data-photo-card>
          <img
            src={photo}
            alt="SEED Lab 实验室日常照片"
            loading={index < 2 ? "eager" : "lazy"}
            decoding="async"
          />
        </figure>
      ))}
    </section>
  </main>

  <script is:inline>
    (() => {
      const wall = document.querySelector('[data-photo-wall]');
      if (!wall) return;

      const cards = Array.from(wall.querySelectorAll('[data-photo-card]'));
      for (let i = cards.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((card) => wall.appendChild(card));
    })();
  </script>
</BaseLayout>

<style>
  .photo-wall {
    column-count: 2;
    column-gap: 1.1rem;
    max-width: 78rem;
    margin-inline: auto;
  }

  .photo-card {
    break-inside: avoid;
    margin: 0 0 1.1rem;
    overflow: hidden;
    border: 1px solid rgba(40, 72, 59, .09);
    border-radius: 1.25rem;
    background: #f7f5ee;
    box-shadow: 0 10px 30px rgba(32, 49, 44, .045);
    transform: translateZ(0);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  .photo-card:hover {
    transform: translateY(-3px);
    border-color: rgba(91, 128, 79, .22);
    box-shadow: 0 16px 38px rgba(32, 49, 44, .07);
  }

  .photo-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1280px) {
    .photo-wall {
      column-gap: 1.35rem;
    }

    .photo-card {
      margin-bottom: 1.35rem;
    }
  }

  @media (max-width: 760px) {
    .photo-wall {
      column-count: 1;
      column-gap: 0;
    }

    .photo-card {
      margin-bottom: .9rem;
      border-radius: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-card {
      transition: none;
    }
  }
</style>
