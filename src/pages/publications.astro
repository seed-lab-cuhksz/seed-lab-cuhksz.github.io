const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="研究成果 Publications"
  description="SEED Lab 负责人曾广宇教授的研究成果与学术发表。"
>
  <main class="publications-page">
    <header class="publications-header">
      <div class="container-page">
        <p class="header-eyebrow">研究成果</p>
        <span class="header-rule" aria-hidden="true"></span>
        <h1>研究成果 <span>Publications</span></h1>
        <p class="header-lead">按年份列出曾广宇教授参与发表的研究成果。作者信息中突出显示 Guangyu Zeng，方便核对。</p>
      </div>
    </header>

    <div class="container-page publications-content">
      <div class="publication-toolbar">
        <p>列表以曾广宇教授 Google Scholar 当前记录与学校个人主页发表列表为主要核对依据。</p>
        <div class="publication-links">
          <a href="https://scholar.google.com/citations?user=wwkuG-YAAAAJ&hl=en&view_op=list_works&sortby=pubdate" target="_blank" rel="noreferrer">Google Scholar ↗</a>
          <a href="https://myweb.cuhk.edu.cn/zenggy/Home/AcademicPublications" target="_blank" rel="noreferrer">学校发表列表 ↗</a>
        </div>
      </div>

      <div class="year-list">
        {years.map((year) => (
          <section class="year-section" aria-labelledby={`year-${year}`}>
            <div class="year-heading">
              <h2 id={`year-${year}`}>{year}</h2>
              <span>{publications.filter((publication) => publication.year === year).length} publications</span>
            </div>

            <div class="publication-list">
              {publications
                .filter((publication) => publication.year === year)
                .map((publication) => (
                  <article class="publication-row">
                    <div class="publication-type">{publication.type}</div>
                    <div class="publication-copy">
                      <h3>{publication.title}</h3>
                      <p class="publication-authors" set:html={publication.authors}></p>
                      <p class="publication-venue">{publication.venue}</p>
                    </div>
                    <a class="publication-link" href={publication.url} target="_blank" rel="noreferrer" aria-label={`Open ${publication.title}`}>↗</a>
                  </article>
                ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .publications-page {
    background: #fff;
    color: #20312c;
  }

  .publications-header {
    padding: 3.1rem 0 2.8rem;
    border-bottom: 1px solid rgba(32, 59, 48, .08);
    background: linear-gradient(to bottom, #f2f8f4 0%, #ffffff 100%);
  }

  .header-eyebrow {
    margin: 0;
    color: #297d75;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .header-rule {
    display: block;
    width: 2.8rem;
    height: 2px;
    margin-top: .9rem;
    border-radius: 999px;
    background: #359b90;
  }

  .publications-header h1 {
    margin: 1rem 0 0;
    color: #172033;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -.035em;
    font-weight: 720;
  }

  .publications-header h1 span {
    font-weight: 650;
  }

  .header-lead {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: #64748b;
    font-size: .95rem;
    line-height: 1.75;
  }

  .publications-content {
    padding-top: 1.8rem;
    padding-bottom: 5rem;
  }

  .publication-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .publication-toolbar > p {
    margin: 0;
    max-width: 44rem;
    color: #64748b;
    font-size: .82rem;
    line-height: 1.7;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .65rem 1rem;
  }

  .publication-links a {
    color: #336d50;
    font-size: .79rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .publication-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .year-section {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    padding: 2.6rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .year-heading h2 {
    margin: 0;
    color: #17312a;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    line-height: 1;
    letter-spacing: -.03em;
    font-weight: 650;
  }

  .year-heading span {
    display: block;
    margin-top: .55rem;
    color: #94a3b8;
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .publication-row {
    display: grid;
    grid-template-columns: 7.4rem minmax(0, 1fr) 1.7rem;
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0;
    border-top: 1px solid #edf2f7;
  }

  .publication-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .publication-type {
    padding-top: .12rem;
    color: #428863;
    font-size: .59rem;
    font-weight: 750;
    letter-spacing: .07em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .publication-copy h3 {
    margin: 0;
    color: #1e293b;
    font-family: var(--font-sans);
    font-size: clamp(.92rem, 1.25vw, 1.05rem);
    font-weight: 650;
    line-height: 1.5;
  }

  .publication-authors {
    margin: .38rem 0 0;
    color: #64748b;
    font-size: .76rem;
    line-height: 1.55;
  }

  .publication-authors :global(strong) {
    color: #2b5843;
    font-weight: 750;
  }

  .publication-venue {
    margin: .28rem 0 0;
    color: #81909e;
    font-size: .76rem;
    line-height: 1.5;
  }

  .publication-link {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border: 1px solid #dbe5df;
    border-radius: 999px;
    color: #336d50;
    font-size: .8rem;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .publication-row:hover .publication-link {
    transform: translate(2px, -2px);
    border-color: #91c2a3;
    background: #f2f8f4;
  }

  @media (max-width: 760px) {
    .publications-header {
      padding: 2.6rem 0 2.3rem;
    }

    .publication-toolbar {
      display: grid;
    }

    .publication-links {
      justify-content: flex-start;
    }

    .year-section {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .publication-row {
      grid-template-columns: 1fr 1.7rem;
      gap: .6rem .8rem;
    }

    .publication-type {
      grid-column: 1 / -1;
    }
  }
</style>
