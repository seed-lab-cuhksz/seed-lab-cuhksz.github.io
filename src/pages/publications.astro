---
import BaseLayout from "../components/BaseLayout.astro";

const directions = [
  {
    number: "01",
    title: "早期社会认知与神经行为机制",
    titleEn: "Early Social Cognition & Neurobehavioral Development",
    summary: "研究婴幼儿共同注意、目光行为、社会动机与情绪理解如何形成，以及这些早期社会能力背后的行为、生理与神经机制。",
    methods: ["Behavioral Observation", "Eye Tracking", "Physiology"],
    projects: ["催产素与共同注意", "亲子互动与发展"],
  },
  {
    number: "02",
    title: "个体差异、自闭症风险与早期识别",
    titleEn: "Individual Differences, Autism Risk & Early Identification",
    summary: "研究儿童早期注意、社会互动与生理反应中的个体差异，并探索更自然、客观的自闭症风险多模态早期识别方法。",
    methods: ["Parent–Child Interaction", "EEG / fNIRS", "Multimodal Modeling"],
    projects: ["亲子互动与发展", "“1+1+1”联合资助计划", "催产素与共同注意"],
  },
  {
    number: "03",
    title: "家庭、自然情境与儿童福祉",
    titleEn: "Family, Naturalistic Contexts & Child Wellbeing",
    summary: "研究亲子互动、家庭经验与自然环境接触如何关联儿童的情绪、行为调节、社会适应与整体福祉。",
    methods: ["Parent–Child Interaction", "Parent Report", "Naturalistic Research"],
    projects: ["亲子互动与发展", "自然童行", "婴幼儿幸福感量表中文版"],
  },
  {
    number: "04",
    title: "多模态测量、人工智能与数字化支持",
    titleEn: "Multimodal Measurement, AI & Digital Support",
    summary: "结合眼动、EEG、fNIRS、行为与计算方法，发展更客观、低负担且可扩展的儿童发展测量、人工智能研究与数字化支持工具。",
    methods: ["Multimodal Data", "Machine Learning / AI", "Digital Support"],
    projects: ["VLM Social Understanding", "“1+1+1”联合资助计划", "十月之礼"],
  },
];

const publications = [
