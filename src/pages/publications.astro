    venue: "Developmental Psychobiology, 64(7), e22324",
    url: "https://doi.org/10.1002/dev.22324",
  },
  {
    year: 2021,
    type: "Journal Article",
    title: "Newborn Auditory Brainstem Responses of Children With Developmental Disabilities",
    authors: "Christine F. Delgado, Elizabeth A. Simpson, O. Miron, Rafael E. Delgado, <strong>Guangyu Zeng</strong>, A. Gutierrez",
    venue: "Journal of Autism and Developmental Disorders, 53, 776–788",
    url: "https://doi.org/10.1007/s10803-021-05126-1",
  },
  {
    year: 2021,
    type: "Journal Article",
    title: "Prolonged Auditory Brainstem Response in Universal Hearing Screening of Newborns With Autism Spectrum Disorder",
    authors: "O. Miron, Rafael E. Delgado, Christine F. Delgado, Elizabeth A. Simpson, K.-H. Yu, A. Gutierrez, <strong>Guangyu Zeng</strong>, J. N. Gerstenberger, I. S. Kohane",
    venue: "Autism Research, 14(1), 46–52",
    url: "https://doi.org/10.1002/aur.2422",
  },
  {
    year: 2020,
    type: "Journal Article",
    title: "Face Detection in 2- to 6-Month-Old Infants Is Influenced by Gaze Direction and Species",
    authors: "Elizabeth A. Simpson, Sarah E. Maylott, S. G. Mitsven, <strong>Guangyu Zeng</strong>, Krisztina V. Jakobsen",
    venue: "Developmental Science, 23(2), e12902",
    url: "https://doi.org/10.1111/desc.12902",
  },
];

const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="研究成果 Publications"
  description="SEED Lab 的核心研究方向与曾广宇教授的研究成果和学术发表。"
>
  <main class="publications-page">
    <section id="research-directions" class="research-directions scroll-mt-28">
      <div class="container-page">
        <div class="research-heading">
          <div>
            <p class="section-eyebrow">SEED LAB · RESEARCH DIRECTIONS</p>
            <span class="section-rule" aria-hidden="true"></span>
            <h1>研究方向 <span>Research Directions</span></h1>
            <p>我们从发展机制、个体差异、真实生活情境与研究方法四个相互连接的层面，理解儿童早期社会发展的共同规律与差异。</p>
          </div>
          <a href="/projects">查看在研项目 <span aria-hidden="true">→</span></a>
        </div>

        <div class="direction-grid">
          {directions.map((direction) => (
            <article class="direction-card">
              <header>
                <span>{direction.number}</span>
                <div>
                  <h2>{direction.title}</h2>
                  <p class="direction-en">{direction.titleEn}</p>
                </div>
              </header>
              <p class="direction-summary">{direction.summary}</p>
              <div class="direction-meta">
                <div>
                  <strong>Methods</strong>
                  <p>{direction.methods.join(" · ")}</p>
                </div>
                <div>
                  <strong>Related Projects</strong>
                  <p>{direction.projects.join(" · ")}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="publication-intro">
      <div class="container-page publication-intro-inner">
        <div>
          <p class="section-eyebrow">PUBLICATIONS</p>
          <h2>研究成果 <span>Publications</span></h2>
          <p>按年份列出曾广宇教授参与发表的研究成果。作者信息中突出显示 Guangyu Zeng，方便核对。</p>
        </div>
        <div class="publication-links">
          <a href="https://scholar.google.com/citations?user=wwkuG-YAAAAJ&hl=en&view_op=list_works&sortby=pubdate" target="_blank" rel="noreferrer">Google Scholar ↗</a>
          <a href="https://myweb.cuhk.edu.cn/zenggy/Home/AcademicPublications" target="_blank" rel="noreferrer">学校发表列表 ↗</a>
        </div>
      </div>
    </section>

    <div class="container-page publications-content">
      <div class="publication-toolbar">
        <p>列表以曾广宇教授 Google Scholar 当前记录与学校个人主页发表列表为主要核对依据。</p>
      </div>

      <div class="year-list">
        {years.map((year) => (
          <section class="year-section" aria-labelledby={`year-${year}`}>
            <div class="year-heading">
              <h2 id={`year-${year}`}>{year}</h2>
              <span>{publications.filter((publication) => publication.year === year).length} publications</span>
            </div>

            <div class="publication-list">
              {publications
                .filter((publication) => publication.year === year)
                .map((publication) => (
                  <article class="publication-row">
                    <div class="publication-type">{publication.type}</div>
                    <div class="publication-copy">
                      <h3>{publication.title}</h3>
                      <p class="publication-authors" set:html={publication.authors}></p>
                      <p class="publication-venue">{publication.venue}</p>
                    </div>
                    <a class="publication-link" href={publication.url} target="_blank" rel="noreferrer" aria-label={`Open ${publication.title}`}>↗</a>
                  </article>
                ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .publications-page { background: #fff; color: #20312c; }

  .research-directions {
    padding: 2.2rem 0 2rem;
    border-bottom: 1px solid rgba(32, 59, 48, .09);
    background: linear-gradient(to bottom, #f2f8f4 0%, #ffffff 100%);
  }

  .research-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .section-eyebrow {
    margin: 0;
    color: #297d75;
    font-size: .66rem;
    font-weight: 750;
    letter-spacing: .11em;
  }

  .section-rule {
    display: block;
    width: 2.65rem;
    height: 2px;
    margin-top: .65rem;
    border-radius: 999px;
    background: #359b90;
  }

  .research-heading h1,
  .publication-intro h2 {
    margin: .7rem 0 0;
    color: #172033;
    font-size: clamp(1.7rem, 2.7vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: -.03em;
    font-weight: 690;
  }

  .research-heading h1 span,
  .publication-intro h2 span { font-weight: 620; }

  .research-heading > div > p:last-child,
  .publication-intro-inner > div:first-child > p:last-child {
    max-width: 50rem;
    margin: .65rem 0 0;
    color: #64748b;
    font-size: .8rem;
    line-height: 1.65;
  }

  .research-heading > a {
    flex: 0 0 auto;
    padding-bottom: .2rem;
    border-bottom: 1px solid rgba(85, 116, 64, .32);
    color: #557440;
    font-size: .73rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .direction-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
    margin-top: 1.35rem;
  }

  .direction-card {
    padding: 1rem 1.15rem;
    border: 1px solid rgba(38, 61, 52, .10);
    border-radius: .85rem;
    background: rgba(255,255,255,.72);
  }

  .direction-card header {
    display: grid;
    grid-template-columns: 1.55rem minmax(0, 1fr);
    gap: .6rem;
    align-items: start;
  }

  .direction-card header > span {
    padding-top: .12rem;
    color: #a77d66;
    font-family: var(--font-serif);
    font-size: .66rem;
    font-style: italic;
  }

  .direction-card h2 {
    margin: 0;
    color: #22372f;
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
  }

  .direction-en {
    margin: .18rem 0 0;
    color: #a77f69;
    font-family: var(--font-serif);
    font-size: .64rem;
    font-style: italic;
    line-height: 1.35;
  }

  .direction-summary {
    margin: .55rem 0 0 2.15rem;
    color: #5f6d67;
    font-size: .72rem;
    line-height: 1.62;
  }

  .direction-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .7rem;
    margin: .65rem 0 0 2.15rem;
    padding-top: .55rem;
    border-top: 1px solid rgba(38, 61, 52, .07);
  }

  .direction-meta strong {
    color: #6c7d75;
    font-size: .54rem;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .direction-meta p {
    margin: .2rem 0 0;
    color: #64746c;
    font-size: .58rem;
    line-height: 1.45;
  }

  .publication-intro {
    padding: 2rem 0 1.55rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .publication-intro-inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .65rem 1rem;
  }

  .publication-links a {
    color: #336d50;
    font-size: .79rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .publication-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .publications-content { padding-top: 1.35rem; padding-bottom: 5rem; }

  .publication-toolbar {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .publication-toolbar > p {
    margin: 0;
    max-width: 44rem;
    color: #64748b;
    font-size: .78rem;
    line-height: 1.65;
  }

  .year-section {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.25rem);
    padding: 2.6rem 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .year-heading h2 {
    margin: 0;
    color: #17312a;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    line-height: 1;
    letter-spacing: -.03em;
    font-weight: 650;
  }

  .year-heading span {
    display: block;
    margin-top: .55rem;
    color: #94a3b8;
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .publication-row {
    display: grid;
    grid-template-columns: 7.4rem minmax(0, 1fr) 1.7rem;
    gap: 1rem;
    align-items: start;
    padding: 1.15rem 0;
    border-top: 1px solid #edf2f7;
  }

  .publication-row:first-child { border-top: 0; padding-top: 0; }

  .publication-type {
    padding-top: .12rem;
    color: #428863;
    font-size: .59rem;
    font-weight: 750;
    letter-spacing: .07em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .publication-copy h3 {
    margin: 0;
    color: #1e293b;
    font-family: var(--font-sans);
    font-size: clamp(.92rem, 1.25vw, 1.05rem);
    font-weight: 650;
    line-height: 1.5;
  }

  .publication-authors {
    margin: .38rem 0 0;
    color: #64748b;
    font-size: .76rem;
    line-height: 1.55;
  }

  .publication-authors :global(strong) { color: #2b5843; font-weight: 750; }

  .publication-venue {
    margin: .28rem 0 0;
    color: #81909e;
    font-size: .76rem;
    line-height: 1.5;
  }

  .publication-link {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    place-items: center;
    border: 1px solid #dbe5df;
    border-radius: 999px;
    color: #336d50;
    font-size: .8rem;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .publication-row:hover .publication-link {
    transform: translate(2px, -2px);
    border-color: #91c2a3;
    background: #f2f8f4;
  }

  @media (max-width: 760px) {
    .research-heading,
    .publication-intro-inner { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .direction-grid { grid-template-columns: 1fr; }
    .direction-meta { grid-template-columns: 1fr; }
    .publication-links { justify-content: flex-start; }
    .year-section { grid-template-columns: 1fr; gap: 1.15rem; }
    .publication-row { grid-template-columns: 1fr 1.7rem; gap: .6rem .8rem; }
    .publication-type { grid-column: 1 / -1; }
  }
</style>
