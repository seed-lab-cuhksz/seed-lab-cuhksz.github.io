const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="研究成果 Publications"
  description="SEED Lab 负责人曾广宇教授的研究成果与学术发表。"
>
  <PageHeader
    eyebrow="研究成果"
    title="研究成果 Publications"
    lead="这里汇总 SEED Lab 负责人曾广宇教授参与发表的期刊论文、会议论文、注册报告与预印本，并按年份倒序排列。"
  />

  <main class="container-page pb-20 pt-10 sm:pt-12">
    <div class="publication-toolbar">
      <p>完整列表持续更新。最新引用与版本信息可通过 Google Scholar 或学校个人主页查看。</p>
      <div class="publication-links">
        <a href="https://scholar.google.com/citations?user=wwkuG-YAAAAJ&hl=en" target="_blank" rel="noreferrer">Google Scholar ↗</a>
        <a href="https://myweb.cuhk.edu.cn/zenggy/Home/AcademicPublications" target="_blank" rel="noreferrer">学校发表列表 ↗</a>
      </div>
    </div>

    <div class="year-list">
      {years.map((year) => (
        <section class="year-section" aria-labelledby={`year-${year}`}>
          <div class="year-heading">
            <h2 id={`year-${year}`}>{year}</h2>
            <span>{publications.filter((publication) => publication.year === year).length} outputs</span>
          </div>

          <div class="publication-list">
            {publications
              .filter((publication) => publication.year === year)
              .map((publication) => (
                <article class="publication-row">
                  <div class="publication-type">{publication.type}</div>
                  <div class="publication-copy">
                    <h3>{publication.title}</h3>
                    <p>{publication.venue}</p>
                  </div>
                  <a class="publication-link" href={publication.url} target="_blank" rel="noreferrer" aria-label={`Open ${publication.title}`}>
                    ↗
                  </a>
                </article>
              ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .publication-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 0 2.4rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .publication-toolbar > p {
    margin: 0;
    max-width: 42rem;
    color: #64748b;
    font-size: .94rem;
    line-height: 1.8;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .7rem 1.25rem;
  }

  .publication-links a {
    color: #336d50;
    font-size: .84rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .publication-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .year-list {
    display: grid;
  }

  .year-section {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(3rem, 5vw, 4.5rem) 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .year-heading h2 {
    margin: 0;
    color: #17312a;
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1;
    letter-spacing: -.04em;
  }

  .year-heading span {
    display: block;
    margin-top: .65rem;
    color: #94a3b8;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .publication-list {
    display: grid;
  }

  .publication-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 2rem;
    gap: 1.25rem;
    align-items: start;
    padding: 1.45rem 0;
    border-top: 1px solid #edf2f7;
  }

  .publication-row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .publication-type {
    padding-top: .2rem;
    color: #428863;
    font-size: .68rem;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .publication-copy h3 {
    margin: 0;
    color: #1e293b;
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 600;
    line-height: 1.45;
  }

  .publication-copy p {
    margin: .45rem 0 0;
    color: #64748b;
    font-size: .87rem;
    line-height: 1.6;
  }

  .publication-link {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid #dbe5df;
    border-radius: 999px;
    color: #336d50;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }

  .publication-row:hover .publication-link {
    transform: translate(2px, -2px);
    border-color: #91c2a3;
    background: #f2f8f4;
  }

  @media (max-width: 760px) {
    .publication-toolbar {
      display: grid;
    }

    .publication-links {
      justify-content: flex-start;
    }

    .year-section {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .publication-row {
      grid-template-columns: 1fr 2rem;
      gap: .75rem 1rem;
    }

    .publication-type {
      grid-column: 1 / -1;
    }
  }
</style>
