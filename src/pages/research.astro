---
import BaseLayout from "../components/BaseLayout.astro";

const directions = [
  {
    number: "01",
    title: "早期社会认知与神经行为机制",
    titleEn: "Early Social Cognition & Neurobehavioral Development",
    summary:
      "研究婴幼儿共同注意、目光行为、社会动机与情绪理解如何形成，以及这些早期社会能力背后的行为、生理与神经机制。",
    methods: ["Behavioral Observation", "Eye Tracking", "Physiology"],
    projects: ["催产素与共同注意", "亲子互动与发展"],
  },
  {
    number: "02",
    title: "个体差异、自闭症风险与早期识别",
    titleEn: "Individual Differences, Autism Risk & Early Identification",
    summary:
      "研究儿童早期注意、社会互动与生理反应中的个体差异，并探索更自然、客观的自闭症风险多模态早期识别方法。",
    methods: ["Parent–Child Interaction", "EEG / fNIRS", "Multimodal Modeling"],
    projects: ["亲子互动与发展", "“1+1+1”联合资助计划", "催产素与共同注意"],
  },
  {
    number: "03",
    title: "家庭、自然情境与儿童福祉",
    titleEn: "Family, Naturalistic Contexts & Child Wellbeing",
    summary:
      "研究亲子互动、家庭经验与自然环境接触如何关联儿童的情绪、行为调节、社会适应与整体福祉。",
    methods: ["Parent–Child Interaction", "Parent Report", "Naturalistic Research"],
    projects: ["亲子互动与发展", "自然童行", "婴幼儿幸福感量表中文版"],
  },
  {
    number: "04",
    title: "多模态测量、人工智能与数字化支持",
    titleEn: "Multimodal Measurement, AI & Digital Support",
    summary:
      "结合眼动、EEG、fNIRS、行为与计算方法，发展更客观、低负担且可扩展的儿童发展测量与数字化支持工具。",
    methods: ["Multimodal Data", "Machine Learning / AI", "Digital Support"],
    projects: ["LLM 项目", "“1+1+1”联合资助计划", "The Gift of the Tenth Month"],
  },
];
---

<BaseLayout
  title="研究方向 Research"
  description="SEED Lab 的四条核心研究主线：早期社会认知、个体差异与自闭症早期识别、家庭与儿童福祉，以及多模态测量与人工智能。"
>
  <main class="research-page compact-research">
    <section class="overview-header">
      <div class="container-page overview-header-inner">
        <div>
          <p class="overview-eyebrow">SEED LAB · RESEARCH DIRECTIONS</p>
          <div class="overview-rule"></div>
          <h1>研究方向 <span>Research</span></h1>
          <p class="overview-lead">
            我们从发展机制、个体差异、真实生活情境与研究方法四个相互连接的层面，理解儿童早期社会发展的共同规律与差异。
          </p>
        </div>
        <a class="projects-jump" href="/projects">查看在研项目 <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="container-page overview-grid" aria-label="SEED Lab 研究方向">
      {directions.map((direction) => (
        <article class="direction-panel">
          <div class="panel-sprout" aria-hidden="true"><i></i><b></b></div>

          <header class="panel-header">
            <span class="panel-number">{direction.number}</span>
            <div>
              <h2>{direction.title}</h2>
              <p class="panel-en">{direction.titleEn}</p>
            </div>
          </header>

          <p class="panel-summary">{direction.summary}</p>

          <div class="panel-meta">
            <div class="meta-row">
              <p class="meta-label">Methods</p>
              <div class="method-list">
                {direction.methods.map((method) => <span>{method}</span>)}
              </div>
            </div>

            <div class="meta-row projects-row">
              <p class="meta-label">Related Projects</p>
              <div class="project-list">
                {direction.projects.map((project) => (
                  <a href="/projects">{project}</a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .compact-research {
    min-height: calc(100vh - 5rem);
    background: #fff;
    color: #20312c;
  }

  .overview-header {
    border-bottom: 1px solid rgba(38, 61, 52, .08);
    background: linear-gradient(to bottom, #f2f8f4 0%, #ffffff 100%);
  }

  .overview-header-inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 1.8rem;
    padding-bottom: 1.55rem;
  }

  .overview-eyebrow {
    margin: 0;
    color: #297d75;
    font-size: .63rem;
    font-weight: 750;
    letter-spacing: .1em;
  }

  .overview-rule {
    width: 2.6rem;
    height: 2px;
    margin-top: .65rem;
    border-radius: 999px;
    background: #359b90;
  }

  .overview-header h1 {
    margin: .65rem 0 0;
    color: #0f172a;
    font-size: clamp(1.65rem, 2.4vw, 2rem);
    line-height: 1.08;
    letter-spacing: -.025em;
    font-weight: 680;
  }

  .overview-header h1 span {
    font-size: .92em;
    font-weight: inherit;
  }

  .overview-lead {
    margin: .6rem 0 0;
    max-width: 52rem;
    color: #64748b;
    font-size: .78rem;
    line-height: 1.65;
  }

  .projects-jump {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding-bottom: .22rem;
    border-bottom: 1px solid rgba(85, 116, 64, .32);
    color: #557440;
    font-size: .72rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .projects-jump span {
    transition: transform .2s ease;
  }

  .projects-jump:hover span {
    transform: translateX(.18rem);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: 1.25rem;
    padding-bottom: 1.8rem;
  }

  .direction-panel {
    position: relative;
    min-width: 0;
    padding: 1.2rem 1.55rem 1.15rem;
    border-right: 1px solid rgba(38, 61, 52, .10);
    border-bottom: 1px solid rgba(38, 61, 52, .10);
    transition: background .25s ease;
  }

  .direction-panel:nth-child(odd) {
    border-left: 1px solid rgba(38, 61, 52, .10);
  }

  .direction-panel:nth-child(-n + 2) {
    border-top: 1px solid rgba(38, 61, 52, .10);
  }

  .direction-panel:hover,
  .direction-panel:focus-within {
    background: #fbfdfb;
  }

  .panel-header {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: .75rem;
    align-items: start;
  }

  .panel-number {
    padding-top: .12rem;
    color: #a77d66;
    font-family: var(--font-serif);
    font-size: .72rem;
    font-style: italic;
  }

  .panel-header h2 {
    margin: 0;
    color: #22372f;
    font-size: clamp(1.05rem, 1.65vw, 1.32rem);
    line-height: 1.28;
    letter-spacing: -.018em;
    font-weight: 720;
  }

  .panel-en {
    margin: .22rem 0 0;
    color: #a77f69;
    font-family: var(--font-serif);
    font-size: .68rem;
    font-style: italic;
    line-height: 1.35;
  }

  .panel-summary {
    margin: .75rem 0 0 2.45rem;
    max-width: 39rem;
    color: #5f6d67;
    font-size: .76rem;
    line-height: 1.68;
  }

  .panel-meta {
    display: grid;
    gap: .5rem;
    margin: .8rem 0 0 2.45rem;
    padding-top: .65rem;
    border-top: 1px solid rgba(38, 61, 52, .07);
  }

  .meta-row {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    gap: .55rem;
    align-items: start;
  }

  .meta-label {
    margin: .15rem 0 0;
    color: #6c7d75;
    font-size: .57rem;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .method-list,
  .project-list {
    display: flex;
    flex-wrap: wrap;
    gap: .3rem .38rem;
  }

  .method-list span {
    padding: .22rem .42rem;
    border: 1px solid rgba(68, 94, 81, .12);
    border-radius: 999px;
    color: #617068;
    background: #fff;
    font-size: .58rem;
    line-height: 1.2;
  }

  .project-list a {
    padding: .18rem 0;
    border-bottom: 1px solid rgba(111, 139, 74, .22);
    color: #557440;
    font-size: .59rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .project-list a:hover {
    color: #304c35;
    border-bottom-color: rgba(85, 116, 64, .6);
  }

  .panel-sprout {
    position: absolute;
    top: .9rem;
    right: 1.1rem;
    width: 1.2rem;
    height: 1.35rem;
    opacity: 0;
    transform: translateY(.35rem) scale(.78);
    transition: opacity .25s ease, transform .32s ease;
  }

  .panel-sprout::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: .95rem;
    background: #718f4a;
  }

  .panel-sprout i,
  .panel-sprout b {
    position: absolute;
    top: .2rem;
    width: .58rem;
    height: .34rem;
    background: #8aa45d;
  }

  .panel-sprout i {
    right: 50%;
    border-radius: 90% 10% 90% 10%;
    transform: rotate(18deg);
  }

  .panel-sprout b {
    left: 50%;
    border-radius: 10% 90% 10% 90%;
    transform: rotate(-18deg);
  }

  .direction-panel:hover .panel-sprout,
  .direction-panel:focus-within .panel-sprout {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (max-width: 920px) {
    .overview-header-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .overview-grid {
      grid-template-columns: 1fr;
    }

    .direction-panel,
    .direction-panel:nth-child(odd) {
      border-left: 1px solid rgba(38, 61, 52, .10);
    }

    .direction-panel:nth-child(n + 2) {
      border-top: 0;
    }
  }

  @media (max-width: 640px) {
    .overview-header-inner {
      padding-top: 1.5rem;
      padding-bottom: 1.3rem;
    }

    .overview-header h1 {
      font-size: 1.55rem;
    }

    .overview-lead {
      font-size: .76rem;
    }

    .overview-grid {
      padding-top: 1rem;
    }

    .direction-panel {
      padding: 1.1rem 1rem 1rem;
    }

    .panel-header {
      grid-template-columns: 1.45rem minmax(0, 1fr);
      gap: .55rem;
    }

    .panel-summary,
    .panel-meta {
      margin-left: 2rem;
    }

    .meta-row {
      grid-template-columns: 1fr;
      gap: .3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-jump span,
    .panel-sprout {
      transition: none;
    }
  }
</style>
