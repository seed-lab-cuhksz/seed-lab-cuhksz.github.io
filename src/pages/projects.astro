---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const projects = [
  {
    tag: "共同注意与自闭症",
    status: "Ongoing",
    titleZh: "基于催产素的婴幼儿共同注意发展机制及孤独症风险预测与干预研究",
    titleEn: "Oxytocin-Based Mechanisms of Joint Attention Development and Autism Risk Prediction and Intervention in Infants and Toddlers",
    body: "探索共同注意的神经内分泌发展机制，并进一步考察催产素相关指标在自闭症早期风险预测与家庭友好型支持中的研究潜力。",
    methods: ["共同注意", "催产素", "自闭症风险"],
  },
  {
    tag: "亲子互动与发展",
    status: "Ongoing",
    titleZh: "亲子互动与发展项目",
    titleEn: "Parent–Child Interaction and Development",
    body: "结合儿童注意、生理、亲子互动、结构化发展测量与家长报告等多模态信息，研究早期社会发展轨迹及与自闭症相关的早期个体差异；同时关注亲子动作同步、情绪信号与引领—跟随关系及其与儿童社会参与和情绪发展的联系。",
    methods: ["眼动追踪", "EEG / fNIRS", "亲子互动", "Motion Synchrony", "Lead-Follow", "多模态建模"],
  },
  {
    tag: "情绪沟通与跨通道匹配",
    status: "Ongoing",
    titleZh: "婴儿发声的情绪类别与诱发情境跨通道匹配",
    titleEn: "Intermodal Matching of Emotional Category and Eliciting Source Context in Infant Vocalizations",
    body: "通过成人与婴幼儿实验，研究人们如何将婴儿哭声与笑声中的情绪类别和诱发情境与视觉信息进行跨通道匹配，并探索这种能力在早期发展中的出现。",
    methods: ["婴儿发声", "Intermodal Matching", "哭声与笑声", "情绪类别"],
  },
  {
    tag: "听觉发展与脑电",
    status: "Ongoing",
    titleZh: "新生儿听觉发展与脑电反应研究",
    titleEn: "Neonatal Auditory Development and EEG Responses",
    body: "研究新生儿在聆听简单语音时的脑电反应，探索婴儿早期听觉与语言加工的发展特征。",
    methods: ["新生儿", "EEG", "听觉发展", "语音加工"],
  },
  {
    tag: "自然情境与福祉",
    status: "Ongoing",
    titleZh: "自然童行",
    titleEn: "Growing with Nature",
    body: "关注 2–5 岁儿童的自然环境接触如何与幸福感、情绪与行为调节及功能发展相关，并同时关注典型发展与自闭症儿童。",
    methods: ["自然接触", "纵向追踪", "眼动", "家长报告"],
  },
  {
    tag: "测量工具",
    status: "Ongoing",
    titleZh: "婴幼儿幸福感量表中文版",
    titleEn: "Chinese Version of the Infant Wellbeing Scale",
    body: "本土化并验证适用于中国大陆家庭的婴幼儿幸福感问卷，评估其可行性、信度与效度，并关注儿童情绪、行为及互动层面的福祉。",
    methods: ["量表本土化", "家长报告", "信效度", "儿童福祉"],
  },
  {
    tag: "人工智能与社会认知",
    status: "Ongoing",
    titleZh: "视觉语言模型的社会理解",
    titleEn: "VLM Social Understanding",
    body: "研究视觉语言模型能否理解动态社会事件中的互动类型与角色关系，并比较直接回答、物理线索提示与社会线索提示下的模型表现。",
    methods: ["VLM", "社会理解", "社会事件推理", "物理提示", "人类-AI一致性"],
  },
  {
    tag: "数字化家庭支持",
    status: "Ongoing",
    titleZh: "十月之礼",
    titleEn: "The Gift of the Tenth Month",
    body: "开发一款伴侣共同参与的孕期教育严肃游戏，将孕期知识、临床决策、情绪体验与家庭支持转化为可探索、可练习的情境化学习体验。",
    methods: ["严肃游戏", "孕期教育", "伴侣支持", "情境学习"],
  },
];
---

<BaseLayout
  title="在研项目 Projects"
  description="SEED儿童早期社会发展实验室目前开展的研究项目。"
>
  <PageHeader
    eyebrow="当前研究项目"
    title="在研项目 Projects"
    lead="我们的项目围绕婴幼儿社会发展、亲子互动与自闭症早期识别，并延伸到情绪沟通、听觉发展、自然情境、人工智能与数字化家庭支持。"
  />

  <div class="container-page py-10">
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((project, index) => (
        <article class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-primary-300 hover:shadow-lg">
          <div class="absolute right-5 top-4 font-mono text-4xl font-semibold text-primary-50 transition-colors group-hover:text-primary-100">
            {String(index + 1).padStart(2, "0")}
          </div>

          <div class="relative flex flex-wrap items-center gap-x-2 gap-y-1 pr-14">
            <p class="text-[0.68rem] font-semibold tracking-[0.14em] text-accent-600">{project.tag}</p>
            <span class="text-xs text-slate-300">·</span>
            <span class="text-[0.65rem] font-semibold uppercase tracking-[0.11em] text-primary-600">{project.status}</span>
          </div>

          <h2 class="relative mt-3 max-w-3xl text-slate-900 transition-colors group-hover:text-primary-700">
            <span class="block text-[1.06rem] font-semibold leading-snug sm:text-lg">{project.titleZh}</span>
            <span class="mt-1 block font-serif text-sm font-normal italic leading-snug text-slate-500">{project.titleEn}</span>
          </h2>
          <p class="relative mt-3 max-w-3xl text-sm leading-6 text-slate-600">{project.body}</p>
          <div class="relative mt-5 flex flex-wrap gap-1.5">
            {project.methods.map((method) => (
              <span class="rounded-full border border-primary-100 bg-primary-50/60 px-2.5 py-1 text-[0.7rem] font-medium text-primary-800">{method}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
